# Screenshots and snapshots (debug artifacts)
screenshot-*.png
debug-*.png
snapshot*.md

# Raw/test output files
output.json
output_raw.json
output_test.json

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/

# Local working artifacts
tmp/

# Python bytecode. Only ~/.gitignore_global covered this before, so a clone
# without that config would commit scripts/__pycache__/ into a public repo.
__pycache__/
*.pyc

# Personal data — read locally by the Monday pipeline, never published.
# Globs (not exact paths) so atomic-write temp siblings (e.g. receipts.json.tmp)
# can never leak into the public repo on a crash between write and os.replace.
data/preferences.json*
data/receipts.json*
data/receipts/
# Weekly shopping lists, saved on disk via serve.py's /api/shopping. Personal
# (what you buy), so the whole dir is ignored — incl. atomic-write .tmp siblings.
data/shopping/
